<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="项目文件回收站" Manufacturer="项目文件回收站"
           Version="$(var.ProductVersion)" Language="2052" Codepage="936" Scope="perUser"
           UpgradeCode="A90EA4B9-A03F-4BA7-B628-40BAA53EDC37">
    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的项目文件回收站。" />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="InstallFolder" Name="ProjectRecycleBin">
        <Component Id="AppFiles" Guid="D6507E9C-CF93-4672-8FD2-C4D642087383">
          <File Id="AppExecutable" Source="$(var.PayloadDir)\ScriptRecycleBin.exe" />
          <File Source="$(var.PayloadDir)\Microsoft.Web.WebView2.Core.dll" />
          <File Source="$(var.PayloadDir)\WebView2Loader.dll" />
          <File Source="$(var.PayloadDir)\UPSTREAM-LICENSE.txt" />
          <File Source="$(var.PayloadDir)\WebView2-LICENSE.txt" />
          <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\ProjectRecycleBin\Installer"
                         Name="AppFiles" Type="integer" Value="1" KeyPath="yes" />
        </Component>
        <Directory Id="UiFolder" Name="ui">
          <Component Id="AppUi" Guid="66263F13-75F6-4BBD-9870-7B7EB9DE91B6">
            <File Source="$(var.PayloadDir)\ui\index.html" />
            <RemoveFolder Id="RemoveUiFolder" On="uninstall" />
            <RegistryValue Root="HKCU" Key="Software\ProjectRecycleBin\Installer"
                           Name="AppUi" Type="integer" Value="1" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuEntry" Guid="43EA2722-8543-4BF7-9A84-F4883391DBA3">
        <Shortcut Id="StartMenuShortcut" Name="项目文件回收站" Target="[#AppExecutable]"
                  WorkingDirectory="InstallFolder" />
        <RegistryValue Root="HKCU" Key="Software\ProjectRecycleBin\Installer"
                       Name="StartMenuEntry" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Product">
      <ComponentRef Id="AppFiles" />
      <ComponentRef Id="AppUi" />
      <ComponentRef Id="StartMenuEntry" />
    </Feature>
  </Package>
</Wix>
